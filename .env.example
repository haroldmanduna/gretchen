# Copy this file to .env and fill it in. Never commit .env to GitHub.
# On Railway, enter the same names in the service's Variables tab.

# ---- Required ----
# Long random text. WAHA must call: https://YOUR-APP/webhook?key=THIS_VALUE
WEBHOOK_KEY=
# WAHA is the WhatsApp connector (its own Railway service), e.g. https://waha-xxxx.up.railway.app
WAHA_URL=
WAHA_API_KEY=
# WAHA session name. Leave as default unless you changed it in WAHA.
WAHA_SESSION=default

# ---- Bot identity ----
# Dedicated Gretchen SIM, digits only, country code first
BOT_NUMBER=263716987183
# Your own WhatsApp number, digits only, country code first. Only this number can use /admin.
ADMIN_PHONE=

# ---- AI providers (tried in this order) ----
PROVIDER_ORDER=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Daily message limits per plan ----
FREE_LIMIT=10
PREMIUM_LIMIT=150
COHORT_LIMIT=300

# ---- Plan prices (USD), length in days, and access link sent after payment ----
PREMIUM_PRICE=20
PREMIUM_DAYS=30
PREMIUM_LINK=
COHORT_PRICE=60
COHORT_DAYS=60
COHORT_LINK=

# ---- Paynow (EcoCash). Paused: leave PAYMENTS_ENABLED=false until you are ready. ----
PAYMENTS_ENABLED=false
PAYNOW_ID=
PAYNOW_KEY=
# Email Paynow asks for on each payment. Use a real address you control.
PAYNOW_AUTH_EMAIL=
# Public address of this app, e.g. https://YOUR-APP.up.railway.app (no trailing slash)
PUBLIC_URL=

# ---- Storage ----
# Point this at a Railway volume so data survives restarts, e.g. /data/gretchen.db
DB_PATH=./gretchen.db

# Railway sets PORT automatically. Leave empty locally.
PORT=3000
